#
#rule deduplicate:
#    input: os.path.join(DIR_ALIGN, '{timepoint}', 'Aligned.sortedByCoord.out.bam')
#    output: 
#        bam = os.path.join(DIR_ALIGN, '{timepoint}', 'aligned.Aligned.sortedByCoord.out.bam'),
