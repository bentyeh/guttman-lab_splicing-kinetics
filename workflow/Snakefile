# Snakemake appears to import the following Python Standard Library modules by default:
# re, os, sys, signal, json, urllib, copy, subprocess
import glob
import json
import os

##############################################################################
# Initialize settings
##############################################################################

# keys required to be specified in config.yaml
# - dir_fastqs
# - dir_report
# - dir_workup
# - json_samples
# - path_adapters
# - env
configfile: "config.yaml"

##############################################################################
# Get sample files
##############################################################################

with open(config['json_samples']) as f:
    samples = json.load(f)

TIMEPOINTS = sorted(list(samples['timepoints'].keys()), key=int)
READS = ('R1', 'R2')

##############################################################################
# Setup directory structure
# - report
#   - fastqc
#     - raw
#     - trim
# - workup
#   - trim
##############################################################################

# output directories
DIR_FASTQC_RAW = os.path.join(config['dir_report'], 'fastqc', 'raw')
DIR_FASTQC_TRIM = os.path.join(config['dir_report'], 'fastqc', 'trim')
DIR_COUNT = os.path.join(config['dir_report'], 'count')
DIR_TRIM = os.path.join(config['dir_workup'], 'trim')
DIR_ALIGN = os.path.join(config['dir_workup'], 'align')
for directory in (
    DIR_FASTQC_RAW,
    DIR_FASTQC_TRIM,
    DIR_COUNT,
    DIR_TRIM,
    DIR_ALIGN):
    os.makedirs(directory, exist_ok=True)

# log directories
DIR_LOG = os.path.join(config['dir_workup'], 'log')
DIR_LOG_TRIM = os.path.join(DIR_LOG, 'trim')
DIR_LOG_FASTQC = os.path.join(DIR_LOG, 'fastqc')
DIR_LOG_ALIGN = os.path.join(DIR_LOG, 'align')
DIR_LOG_ALIGN_QC = os.path.join(DIR_LOG, 'align_qc')
DIR_LOG_MESSAGES = os.path.join(DIR_LOG, 'messages')
for directory in (
    DIR_LOG_TRIM,
    DIR_LOG_FASTQC,
    DIR_LOG_ALIGN,
    DIR_LOG_ALIGN_QC,
    DIR_LOG_MESSAGES):
    os.makedirs(directory, exist_ok=True)

# output paths
OUT_FASTQC_RAW = [os.path.join(DIR_FASTQC_RAW, f'{timepoint}_{read}_fastqc.html')
                  for read in READS
                  for timepoint in TIMEPOINTS]
OUT_FASTQC_TRIM = [os.path.join(DIR_FASTQC_TRIM, f'{timepoint}_{read}_fastqc.html')
                   for read in READS
                   for timepoint in TIMEPOINTS]
OUT_TRIM = [os.path.join(DIR_TRIM, f'{timepoint}_{read}_trim.fastq.gz')
            for read in READS
            for timepoint in TIMEPOINTS]
OUT_SJ = [os.path.join(DIR_ALIGN, f'{timepoint}', 'SJ.out.tab')
          for timepoint in TIMEPOINTS]
OUT_ALIGN = [os.path.join(DIR_ALIGN, f'{timepoint}', 'Aligned.sortedByCoord.out.bam')
             for timepoint in TIMEPOINTS]
OUT_ALIGN_UNIQUE = [os.path.join(DIR_ALIGN, f'{timepoint}', 'aligned_unique.sorted.bam')
                    for timepoint in TIMEPOINTS]
OUT_COUNT = [os.path.join(DIR_COUNT, f'{timepoint}.count')
             for timepoint in TIMEPOINTS]
OUT_DEDUP_COMPARE = [os.path.join(DIR_ALIGN, f'{timepoint}', 'comparison.tsv')
                     for timepoint in TIMEPOINTS]
OUT_MESSAGES = os.path.join(DIR_LOG, 'messages.log')

##############################################################################
# RULE ALL
##############################################################################

rule all:
    input: [OUT_MESSAGES] + \
           OUT_FASTQC_RAW + OUT_FASTQC_TRIM + \
           OUT_TRIM + \
           OUT_SJ + OUT_ALIGN + \
           OUT_ALIGN_UNIQUE + OUT_COUNT + OUT_DEDUP_COMPARE

rule messages:
    input: [os.path.join(DIR_LOG_MESSAGES, x) for x in os.listdir(DIR_LOG_MESSAGES)]
    output: OUT_MESSAGES
    shell: "cat {input} > {output}"

##############################################################################
# FASTQC
##############################################################################

def get_raw_path_from_fastqc_file(wildcards):
    '''
    Given a filename (without extensions) for a FASTQC output from a raw (untrimmed) FASTQ file,
    return the path to the raw FASTQ file.
    '''
    for timepoint in TIMEPOINTS:
        for read in READS:
            if samples['timepoints'][timepoint][read].split('.fastq')[0] == wildcards.sample:
                return os.path.join(
                    config['dir_fastqs'],
                    samples['timepoints'][timepoint]['folder'],
                    samples['timepoints'][timepoint][read])
    raise KeyError(f'Could not find {wildcards.sample} in samples.')

rule fastqc_raw:
    input: get_raw_path_from_fastqc_file
    output: os.path.join(DIR_FASTQC_RAW, "{sample}_fastqc.html")
    log: os.path.join(DIR_LOG_FASTQC, '{sample}_raw_fastqc.log')
    params:
        outdir = DIR_FASTQC_RAW,
        path_zip = lambda w: os.path.join(DIR_FASTQC_RAW, f'{w.sample}_fastqc.zip')
    conda: config['env']['alignment']
    shell:
        "fastqc --outdir {params.outdir} {input} &> {log} && "
        "rm {params.path_zip}"

def get_fastqc_raw_path(wildcards, directory=DIR_FASTQC_RAW, suffix='_fastqc.html'):
    '''
    Given timepoint and read, return the path to the FASTQC output from a raw (untrimmed) FASTQ file.
    '''
    return os.path.join(
        directory,
        samples['timepoints'][wildcards.timepoint][wildcards.read].split('.fastq')[0] + suffix)

rule fastqc_raw_rename:
    # rename FASTQC HTML and log files
    input:
        html = get_fastqc_raw_path,
        log = lambda x: get_fastqc_raw_path(x, directory=DIR_LOG_FASTQC, suffix='_raw_fastqc.log')
    output:
        html = os.path.join(DIR_FASTQC_RAW, '{timepoint}_{read}_fastqc.html'),
        log = os.path.join(DIR_LOG_FASTQC, '{timepoint}_{read}_raw.log')
    shell:
        '''
        mv {input.html} {output.html}
        mv {input.log} {output.log}
        '''

rule fastqc_trim:
    input: os.path.join(DIR_TRIM, '{sample}_trim.fastq.gz')
    output: os.path.join(DIR_FASTQC_TRIM, '{sample}_trim_fastqc.html')
    log: os.path.join(DIR_LOG_FASTQC, '{sample}_trim.log')
    params:
        outdir = DIR_FASTQC_TRIM,
        path_zip = lambda w: os.path.join(DIR_FASTQC_TRIM, f'{w.sample}_trim_fastqc.zip')
    conda: config['env']['alignment']
    shell:
        "fastqc --outdir {params.outdir} {input} &> {log} && "
        "rm {params.path_zip}"

rule fastqc_trim_rename:
    input: os.path.join(DIR_FASTQC_TRIM, '{timepoint}_{read}_trim_fastqc.html')
    output: os.path.join(DIR_FASTQC_TRIM, '{timepoint}_{read}_fastqc.html')
    shell:
        "mv {input} {output}"

##############################################################################
# Counts
##############################################################################

rule count_all:
    input:
        os.path.join(DIR_COUNT, '{timepoint}.count_raw'),
        os.path.join(DIR_COUNT, '{timepoint}.count_trim'),
        os.path.join(DIR_COUNT, '{timepoint}.count_align'),
        os.path.join(DIR_COUNT, '{timepoint}.count_align_unique'),
        os.path.join(DIR_COUNT, '{timepoint}.count_align_unique_dedup')
    output: os.path.join(DIR_COUNT, '{timepoint}.count')
    shell: "cat {input} > \"{output}\""

rule count_raw:
    input:
        r1 = lambda w: os.path.join(
                config['dir_fastqs'],
                samples['timepoints'][w.timepoint]['folder'],
                samples['timepoints'][w.timepoint]['R1']),
        r2 = lambda w: os.path.join(
            config['dir_fastqs'],
            samples['timepoints'][w.timepoint]['folder'],
            samples['timepoints'][w.timepoint]['R2'])
    output: temp(os.path.join(DIR_COUNT, '{timepoint}.count_raw'))
    shell:
        '''
        echo raw R1 $(($(zcat "{input.r1}" | wc -l) / 4)) > "{output}"
        echo raw R2 $(($(zcat "{input.r2}" | wc -l) / 4)) >> "{output}"
        '''

rule count_trim:
    input:
        r1 = os.path.join(DIR_TRIM, '{timepoint}_R1_trim.fastq.gz'),
        r1_unpaired = os.path.join(DIR_TRIM, '{timepoint}_R1_trim_unpaired.fastq.gz'),
        r2 = os.path.join(DIR_TRIM, '{timepoint}_R2_trim.fastq.gz'),
        r2_unpaired = os.path.join(DIR_TRIM, '{timepoint}_R2_trim_unpaired.fastq.gz')
    output: temp(os.path.join(DIR_COUNT, '{timepoint}.count_trim'))
    shell:
        '''
        echo trim R1 $(($(zcat "{input.r1}" | wc -l) / 4)) > "{output}"
        echo trim R1_unpaired $(($(zcat "{input.r1_unpaired}" | wc -l) / 4)) >> "{output}"
        echo trim R2 $(($(zcat "{input.r2}" | wc -l) / 4)) >> "{output}"
        echo trim R2_unpaired $(($(zcat "{input.r2_unpaired}" | wc -l) / 4)) >> "{output}"
        '''

rule count_align:
    input:
        bam = os.path.join(DIR_ALIGN, '{timepoint}', 'Aligned.sortedByCoord.out.bam'),
        unmapped1 = os.path.join(DIR_ALIGN, '{timepoint}', 'Unmapped.out.mate1'),
        unmapped2 = os.path.join(DIR_ALIGN, '{timepoint}', 'Unmapped.out.mate2')
    output: temp(os.path.join(DIR_COUNT, '{timepoint}.count_align'))
    conda: config['env']['samtools']
    threads: workflow.cores
    shell:
        '''
        echo align R1 $(samtools view --threads {threads} -c -F 0x900 -f 0x40 "{input.bam}") > "{output}"
        echo align R2 $(samtools view --threads {threads} -c -F 0x900 -f 0x80 "{input.bam}") >> "{output}"
        
        # TMPDIR should be set by snakemake's resources.tmpdir;
        # if TMPDIR is not set, set default value for TMPDIR to '/tmp'
        TMPDIR="${{TMPDIR:-/tmp}}"
        tmpfile1="$(mktemp --tmpdir="$TMPDIR" count_align.XXXXXX)"
        tmpfile2="$(mktemp --tmpdir="$TMPDIR" count_align.XXXXXX)"

        # check that the counts of unmapped reads is identical from parsing Unmapped.out.mate1/2
        # note that $NF in awk refers to the last field
        awk 'NR%4==1 {{print $NF}}' "{input.unmapped1}" | sort | uniq -c > "$tmpfile1"
        awk 'NR%4==1 {{print $NF}}' "{input.unmapped2}" | sort | uniq -c > "$tmpfile2"
        ndiff=$(diff "$tmpfile1" "$tmpfile2" | head | wc -l)
        if [ "$ndiff" -gt "0" ]; then
            echo "align R1_unmapped undefined" >> "{output}"
            echo "align R1_unmapped undefined" >> "{output}"
        else
            r1_unmapped=$(awk '{{k=0; if ($2 == "00" || $2 == "01") {{k+=$1}}}} END {{print k}}' "$tmpfile1")
            r2_unmapped=$(awk '{{k=0; if ($2 == "00" || $2 == "10") {{k+=$1}}}} END {{print k}}' "$tmpfile1")
            echo "align R1_unmapped $r1_unmapped" >> "{output}"
            echo "align R2_unmapped $r2_unmapped" >> "{output}"
        fi
        
        rm "$tmpfile1" "$tmpfile2"
        '''

rule count_align_unique:
    input: os.path.join(DIR_ALIGN, '{timepoint}', 'aligned_unique.sorted.bam')
    output: temp(os.path.join(DIR_COUNT, '{timepoint}.count_align_unique'))
    conda: config['env']['samtools']
    threads: workflow.cores
    shell:
        '''
        echo "align_unique R1 $(samtools view --threads {threads} -c -f 0x40 "{input}")" > "{output}"
        echo "align_unique R2 $(samtools view --threads {threads} -c -f 0x80 "{input}")" >> "{output}"
        '''

rule count_align_unique_dedup:
    input:
        dedup = os.path.join(DIR_ALIGN, '{timepoint}', 'aligned_unique_dedup.sorted.bam'),
        dedup2500 = os.path.join(DIR_ALIGN, '{timepoint}', 'aligned_unique_dedup2500.sorted.bam')
    output: temp(os.path.join(DIR_COUNT, '{timepoint}.count_align_unique_dedup'))
    conda: config['env']['samtools']
    threads: workflow.cores
    shell:
        '''
        echo "align_unique_dedup R1 $(samtools view --threads {threads} -c -f 0x40 "{input.dedup}")" > "{output}"
        echo "align_unique_dedup R2 $(samtools view --threads {threads} -c -f 0x80 "{input.dedup}")" >> "{output}"
        echo "align_unique_dedup2500 R1 $(samtools view --threads {threads} -c -f 0x40 "{input.dedup2500}")" >> "{output}"
        echo "align_unique_dedup2500 R2 $(samtools view --threads {threads} -c -f 0x80 "{input.dedup2500}")" >> "{output}"
        '''

##############################################################################
# Trim Adapters
##############################################################################

rule trim:
    input: 
        r1 = lambda w: os.path.join(
            config['dir_fastqs'],
            samples['timepoints'][w.timepoint]['folder'],
            samples['timepoints'][w.timepoint]['R1']),
        r2 = lambda w: os.path.join(
            config['dir_fastqs'],
            samples['timepoints'][w.timepoint]['folder'],
            samples['timepoints'][w.timepoint]['R2'])
    output: 
        r1 = os.path.join(DIR_TRIM, '{timepoint}_R1_trim.fastq.gz'),
        r1_unpaired = os.path.join(DIR_TRIM, '{timepoint}_R1_trim_unpaired.fastq.gz'),
        r2 = os.path.join(DIR_TRIM, '{timepoint}_R2_trim.fastq.gz'),
        r2_unpaired = os.path.join(DIR_TRIM, '{timepoint}_R2_trim_unpaired.fastq.gz')
    log: os.path.join(DIR_LOG_TRIM, '{timepoint}.log')
    params:
        path_adapters = config['path_adapters']
    conda: config['env']['alignment']
    shell:
        "trimmomatic PE -phred33"
        "  {input.r1} {input.r2}"
        "  {output.r1} {output.r1_unpaired}"
        "  {output.r2} {output.r2_unpaired}"
        "  ILLUMINACLIP:{params.path_adapters}:2:20:10:8:True LEADING:10 TRAILING:10 MINLEN:25 &> {log}"

##############################################################################
# Align reads
##############################################################################

rule unzip_annotation:
    input: config['path_annotation']
    output: temp(os.path.join(config['dir_workup'], 'annotation.gtf'))
    params:
        output = os.path.abspath(os.path.join(config['dir_workup'], 'annotation.gtf'))
    shell:
        '''
        if [[ "{input}" == *.gz ]]; then
            zcat {input} > {params.output}
        else
            ln -s -T {input} {params.output}
        fi
        '''

# sole purpose of pass 1 is to detect novel (non-annotated) splice junctions
rule align_pass1:
    input:
        r1 = os.path.join(DIR_TRIM, '{timepoint}_R1_trim.fastq.gz'),
        r2 = os.path.join(DIR_TRIM, '{timepoint}_R2_trim.fastq.gz'),
        genomeDir = config['dir_genome'],
        annotation = ancient(os.path.join(config['dir_workup'], 'annotation.gtf'))
    output: temp(os.path.join(DIR_ALIGN, '{timepoint}', 'SJ_pass1.out.tab'))
    log: os.path.join(DIR_LOG_ALIGN, '{timepoint}_pass1.log')
    params:
        sjdboverhang = config['read_length'] - 1,
        dir_out = os.path.join(DIR_ALIGN, "{timepoint}", ""),
        sjout_pass1 = os.path.join(DIR_ALIGN, '{timepoint}', 'SJ.out.tab')
    conda: config['env']['alignment']
    threads: workflow.cores
    resources:
        mem_mb=40000,
        runtime=600
    shell:
        '''
        STAR \
           --runThreadN {threads} \
           --genomeDir {input.genomeDir} \
           --genomeLoad NoSharedMemory \
           --readFilesIn {input.r1} {input.r2} \
           --readFilesCommand zcat \
           --sjdbGTFfile {input.annotation} \
           --sjdbOverhang {params.sjdboverhang} \
           --alignIntronMin 10 \
           --alignIntronMax 1000000 \
           --alignMatesGapMax 1000000 \
           --alignSJDBoverhangMin 5 \
           --outFileNamePrefix {params.dir_out} \
           --outSAMtype None \
           --outSJfilterCountUniqueMin 10 3 3 3 \
           --outSJfilterCountTotalMin 15 10 10 10 \
           &> {log}
        mv {sjout_pass1} {output}
        '''

# Remove the following (novel) junctions (see https://github.com/alexdobin/STAR/issues/638)
# - junctions from reads mapping to mitochondria and scaffolds
# - novel (unannotated) junctions
rule align_filter_pass1_splice_junctions:
    input: expand(os.path.join(DIR_ALIGN, '{timepoint}', 'SJ_pass1.out.tab'), timepoint=TIMEPOINTS)
    output: os.path.join(DIR_ALIGN, 'SJ_filtered.out.tab')
    shell:
        "cat {input} | "
        "awk -F'\t' '{{if ($1 != \"chrM\" && $1 ~ /^chr/ && $6 == 0) {{print $1,$2,$3,$4}} }}' | "
        "sort | "
        "uniq > {output}"

rule align_pass2:
    input:
        r1 = os.path.join(DIR_TRIM, '{timepoint}_R1_trim.fastq.gz'),
        r2 = os.path.join(DIR_TRIM, '{timepoint}_R2_trim.fastq.gz'),
        genomeDir = config['dir_genome'],
        annotation = ancient(os.path.join(config['dir_workup'], 'annotation.gtf')),
        novel_splice_junctions = os.path.join(DIR_ALIGN, 'SJ_filtered.out.tab')
    output: os.path.join(DIR_ALIGN, '{timepoint}', 'Aligned.sortedByCoord.out.bam')
    log: os.path.join(DIR_LOG_ALIGN, '{timepoint}_pass2.log')
    conda: config['env']['alignment']
    threads: workflow.cores
    params:
        sjdboverhang = config['read_length'] - 1,
        dir_out = os.path.join(DIR_ALIGN, "{timepoint}", "")
    threads: workflow.cores
    resources:
        mem_mb=40000,
        runtime=600
    shell:
        "STAR"
        "  --runThreadN {threads}"
        "  --genomeDir {input.genomeDir}"
        "  --genomeLoad NoSharedMemory"
        "  --readFilesIn {input.r1} {input.r2}"
        "  --readFilesCommand zcat"
        "  --sjdbGTFfile {input.annotation}"
        "  --sjdbOverhang {params.sjdboverhang}"
        "  --sjdbFileChrStartEnd {input.novel_splice_junctions}"
        "  --alignIntronMin 10"
        "  --alignIntronMax 1000000"
        "  --alignMatesGapMax 1000000"
        "  --alignSJDBoverhangMin 5"
        "  --outFileNamePrefix {params.dir_out}"
        "  --outSAMtype BAM SortedByCoordinate"
        "  --outFilterMultimapNmax 50"
        "  --outReadsUnmapped Fastx"
        "  --quantMode GeneCounts"
        "  &> {log}"

##############################################################################
# Filter and QC aligned reads
##############################################################################

rule filter_align_unique:
    input: os.path.join(DIR_ALIGN, '{timepoint}', 'Aligned.sortedByCoord.out.bam')
    output: os.path.join(DIR_ALIGN, '{timepoint}', 'aligned_unique.sorted.bam')
    conda: config['env']['samtools']
    threads: workflow.cores
    shell:
        "samtools view -h --threads {threads} --exclude-flags 0x100 --min-MQ 255 -o \"{output}\" \"{input}\""

rule qc_align:
    input: os.path.join(DIR_ALIGN, '{timepoint}', 'Aligned.sortedByCoord.out.bam')
    output: temp(os.path.join(DIR_LOG_MESSAGES, '{timepoint}_align_qc.log'))
    conda: config['env']['samtools']
    threads: workflow.cores
    shell:
        '''
        # check for reads that are putatively unique (MAPQ=255) but have the 0x100 flag (secondary alignment);
        # there shouldn't be any
        n_MAPQ255_secondary=$(samtools view -c --threads {threads} --require-flags 0x100 --min-MQ 255 {input})
        if [ "$n_MAPQ255_secondary" -gt "0" ]; then
            printf '%s' \
                "Timepoint {wildcards.timepoint} ({input}) has $n_MAPQ255_secondary reads " \
                "with both MAPQ=255 and flag 0x100 set." > "{output}"
        fi
        
        # check for chimeric reads; there shouldn't be any (the default --chimSegmentMin value for STAR is 0,
        # which means no chimeric alignments are output
        n_chimeric=$(samtools view -c --threads {threads} --require-flags 0x800 {input})
        if [ "$n_chimeric" -gt "0" ]; then
            printf '%s' \
                "Timepoint {wildcards.timepoint} ({input}) has $n_chimeric chimeric reads." \
                >> "{output}"
        fi
        
        touch "{output}"
        '''

rule filter_align_dedup:
    input: os.path.join(DIR_ALIGN, '{timepoint}', 'aligned_unique.sorted.bam')
    output: 
        bam = os.path.join(DIR_ALIGN, '{timepoint}', 'aligned_unique_dedup.sorted.bam'),
        metrics = os.path.join(DIR_ALIGN, '{timepoint}', 'aligned_unique_dedup.metrics'),
        bam_2500 = os.path.join(DIR_ALIGN, '{timepoint}', 'aligned_unique_dedup2500.sorted.bam'),
        metrics_2500 = os.path.join(DIR_ALIGN, '{timepoint}', 'aligned_unique_dedup2500.metrics')
    log: os.path.join(DIR_LOG_ALIGN_QC, '{timepoint}_dedup.log')
    conda: config['env']['picard']
    resources:
        mem_mb=10000,
        runtime=300
    shell:
        '''
        echo "----------------------------------------------------------------------" &> {log}
        echo "picard MarkDuplicates OPTICAL_DUPLICATE_PIXEL_DISTANCE <default = 100>" &>> {log}
        echo "----------------------------------------------------------------------" &>> {log}
        echo "" &>> {log}

        picard -Xmx{resources.mem_mb}m MarkDuplicates \
           -I {input} \
           -O {output.bam} \
           -M {output.metrics} \
           --MAX_RECORDS_IN_RAM 1000000 \
           --TAGGING_POLICY All \
           --REMOVE_DUPLICATES &>> {log}

        echo "" &>> {log}
        echo "----------------------------------------------------------------------" &>> {log}
        echo "picard MarkDuplicates OPTICAL_DUPLICATE_PIXEL_DISTANCE 2500"            &>> {log}
        echo "----------------------------------------------------------------------" &>> {log}
        echo "" &>> {log}

        picard -Xmx{resources.mem_mb}m MarkDuplicates \
           -I {input} \
           -O {output.bam_2500} \
           -M {output.metrics_2500} \
           --MAX_RECORDS_IN_RAM 1000000 \
           --TAGGING_POLICY All \
           --REMOVE_DUPLICATES \
           --OPTICAL_DUPLICATE_PIXEL_DISTANCE 2500 &>> {log}
        '''

rule filter_align_dedup_check_identical:
    input:
        dedup = os.path.join(DIR_ALIGN, '{timepoint}', 'aligned_unique_dedup.sorted.bam'),
        dedup2500 = os.path.join(DIR_ALIGN, '{timepoint}', 'aligned_unique_dedup2500.sorted.bam')
    output: os.path.join(DIR_ALIGN, '{timepoint}', 'comparison.tsv')
    conda: config['env']['picard']
    log: os.path.join(DIR_LOG_ALIGN_QC, '{timepoint}.CompareDedup.log')
    resources:
        mem_mb=10000,
        runtime=240
    shell:
        '''
        picard -Xmx{resources.mem_mb}m CompareSAMs \
          --LENIENT_HEADER true \
          --MAX_RECORDS_IN_RAM 1000000 \
          --OUTPUT {output} \
          {input.dedup} \
          {input.dedup2500} &> {log}
        '''
